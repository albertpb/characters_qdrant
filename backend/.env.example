CHARDB_ENVIRONMENT=development
CHARDB_QDRANT_HOST=localhost
CHARDB_QDRANT_PORT=6333
# Optional full URL override, for example: https://qdrant.example.com
# CHARDB_QDRANT_URL=
CHARDB_QDRANT_COLLECTION=characters
CHARDB_TEXT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
CHARDB_IMAGE_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
CHARDB_TEXT_VECTOR_SIZE=2048
CHARDB_IMAGE_VECTOR_SIZE=2048
# CHARDB_HF_TOKEN=hf_your_token
# CHARDB_TEXT_EMBEDDING_DEVICE=cuda:0
# CHARDB_IMAGE_EMBEDDING_DEVICE=cuda:1
# CHARDB_IMAGE_UPLOAD_DIR=data/images
